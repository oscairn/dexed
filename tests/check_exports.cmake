# Fails unless the module exports exactly clap_entry (besides linker-defined markers).
#   cmake -DNM=<nm> -DMODULE=<file> -DAPPLE=<0|1> -P check_exports.cmake
if(APPLE)
    execute_process(COMMAND ${NM} -gU ${MODULE} OUTPUT_VARIABLE out RESULT_VARIABLE rc)
else()
    execute_process(COMMAND ${NM} -D --defined-only ${MODULE} OUTPUT_VARIABLE out RESULT_VARIABLE rc)
endif()
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "nm failed on ${MODULE}")
endif()
string(REPLACE "\n" ";" lines "${out}")
set(symbols "")
foreach(line IN LISTS lines)
    string(REGEX MATCH "[^ ]+$" symbol "${line}")
    if(symbol STREQUAL "" OR symbol MATCHES "^(_edata|_end|__bss_start|_init|_fini)$")
        continue()
    endif()
    list(APPEND symbols ${symbol})
endforeach()
if(NOT symbols STREQUAL "clap_entry" AND NOT symbols STREQUAL "_clap_entry")
    message(FATAL_ERROR "${MODULE} exports: ${symbols}")
endif()
message(STATUS "only clap_entry is exported")
